# The 2.0 page has its own chaptered film. website.yml downloads this release
# asset into dist/video/. For local preview, copy it to public/video/<FILM_ASSET>.
FILM_TAG=website-media
FILM_ASSET=tuicommander-2.0.mp4

# The home film streams on demand from the shared Cloudflare R2 bucket dl-straus.
# Upload the object before deploying the site; it is not part of the Pages build.
HOME_FILM_URL=https://dl.straus.it/tuicommander/tuicommander-2.1-home.mp4
