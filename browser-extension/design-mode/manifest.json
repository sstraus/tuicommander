{
  "manifest_version": 3,
  "name": "TUICommander Design Mode",
  "version": "2.0.0",
  "key": "",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "tabs",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*",
    "https://localhost/*"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Design Mode"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open Design Mode"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://[::1]/*",
        "https://localhost/*"
      ],
      "js": [
        "errors.js",
        "main.js"
      ],
      "world": "MAIN",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://[::1]/*",
        "https://localhost/*"
      ],
      "js": [
        "extract.js",
        "picker.js",
        "errorsBridge.js"
      ],
      "world": "ISOLATED",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "run_at": "document_start"
    }
  ]
}
