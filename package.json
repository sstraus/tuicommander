{
  "name": "tuicommander",
  "private": true,
  "version": "1.8.0",
  "description": "Multi-agent terminal orchestrator with native terminal and Tauri",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "tsc && vite build && node scripts/report-frontend-bundles.mjs --check",
    "bundle:report": "node scripts/report-frontend-bundles.mjs",
    "architecture:cycles": "node scripts/check-frontend-cycles.mjs",
    "architecture:cycles:test": "node scripts/check-frontend-cycles.mjs --self-test",
    "build:watch": "vite build --watch",
    "preview": "vite preview",
    "tauri": "tauri",
    "build:sidecar": "node src-tauri/build-sidecar.mjs",
    "test": "vitest",
    "notices": "node scripts/third-party-notices.mjs",
    "notices:check": "node scripts/third-party-notices.mjs --check",
    "test:plugins": "node --test \"plugins/**/*.test.js\"",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@git-diff-view/core": "^0.1.7",
    "@git-diff-view/solid": "^0.1.7",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@replit/codemirror-css-color-picker": "^6.3.0",
    "@tanstack/solid-virtual": "^3.13.38",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-deep-link": "^2.6.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-notification": "~2.4.0",
    "@tauri-apps/plugin-opener": "^2.7.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "~2.11.0",
    "ansi-to-html": "^0.7.2",
    "dompurify": "3.4.16",
    "marked": "^18.0.12",
    "mermaid": "^12.1.0",
    "qrcode": "^1.5.4",
    "solid-codemirror": "^2.3.3",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@solidjs/testing-library": "^0.8.10",
    "@stryker-mutator/core": "10.0.0",
    "@tauri-apps/cli": "^2.12.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/qrcode": "^1.5.6",
    "@typescript/typescript6": "^6.0.2",
    "@vitest/coverage-v8": "^5.0.0",
    "happy-dom": "20.11.0",
    "jsdom": "^30.0.1",
    "lightningcss": "^1.33.0",
    "rollup": "4.62.2",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-checker": "^0.14.5",
    "vite-plugin-purgecss": "^0.2.13",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0"
  }
}
